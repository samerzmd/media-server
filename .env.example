# Copy this file to .env and replace the placeholder values with actual secrets

# Telegram Bot Token (Get it from BotFather in Telegram)
BOT_TOKEN=your_telegram_bot_token

# Radarr API Key (Found in Radarr settings under "API Key")
RADARR_API_KEY=your_radarr_api_key

# Sonarr API Key (Found in Sonarr settings under "API Key")
SONARR_API_KEY=your_sonarr_api_key

# Prowlarr API Key (Found in Prowlarr settings under "API Key")
PROWLARR_API_KEY=your_prowlarr_api_key

# SubGen data directory (models cache + subgen.env)
subgenai_data_folder=./subgen

# --- recommendarr (Jellyfin -> TMDB -> Radarr/Sonarr recommender) ---
# Jellyfin API key (Jellyfin Dashboard -> Advanced -> API Keys -> +)
JELLYFIN_API_KEY=your_jellyfin_api_key
# Optional: limit to specific Jellyfin user IDs, comma-separated. Empty = all users.
JELLYFIN_USER_IDS=
# TMDB API key (https://www.themoviedb.org/settings/api -> API Key v3 auth)
TMDB_API_KEY=your_tmdb_api_key
# recommendarr dashboard login (CHANGE THESE)
RECOMMENDARR_USER=admin
RECOMMENDARR_PASSWORD=change_me_please
# Optional: fixed Flask session key (leave blank to auto-generate in /data)
RECOMMENDARR_SECRET_KEY=

# --- tarjem (AI Arabic subtitles) ---
# Which brain translates. Defaults to the local Ollama box: free, but slow -
# roughly 1.5 hours per episode on CPU. Set to "anthropic" for Claude, which
# costs money and finishes an episode in minutes.
TARJEM_PROVIDER=ollama
# Local model. Anything Ollama has pulled; check with:
#   curl -s http://localhost:11434/api/tags
# Arabic quality varies far more by model than by size. command-r7b-arabic
# (8B, Cohere) measured both faster and markedly better than qwen3:14b here.
#   ollama pull command-r7b-arabic
TARJEM_OLLAMA_MODEL=command-r7b-arabic
# Only needed if Ollama is not on this host's port 11434.
# TARJEM_OLLAMA_URL=http://host.docker.internal:11434
# Spread the work over more than one machine, kind@url#model per backend.
# A backend that stops answering is parked and retried, so a desktop that
# sleeps does not take the queue down with it.
# TARJEM_ENDPOINTS=ollama@http://host.docker.internal:11434#command-r7b-arabic,openai@http://192.168.1.7:1234/v1#c4ai-command-r7b-arabic-02-2025
# Raise if you increase BATCH_SIZE; too low truncates prompts silently.
# TARJEM_NUM_CTX=8192
# Anthropic API key, used when TARJEM_PROVIDER=anthropic
# (https://console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=your_anthropic_api_key
# Which Claude model the rush button uses. Measured per episode:
#   claude-opus-5 $0.74 | claude-sonnet-5 $0.44 | claude-haiku-4-5 $0.15
TARJEM_MODEL=claude-sonnet-5
# Bazarr API key (Bazarr -> Settings -> General -> Security -> API key)
BAZARR_API_KEY=your_bazarr_api_key
# Password for tarjem's dashboard. Set this - the dashboard can queue paid
# Claude jobs, so it should not be reachable without one.
TARJEM_PASSWORD=change_me_please
# Machine credential for tarjem's webhook and API (the x-api-token header).
TARJEM_TOKEN=
# Set true if you proxy tarjem over HTTPS.
TARJEM_COOKIE_SECURE=false
# Optional overrides - all have working defaults, leave blank to use them.
# claude-opus-5 translates best; claude-sonnet-5 costs less for a big backfill.
# msa | msa-light | gulf | egyptian | levantine
TARJEM_REGISTER=
# How many videos one automatic sweep may queue. Default 5.
TARJEM_SWEEP_LIMIT=
# Set false to stop the periodic sweep and rely on the Bazarr webhook only.
TARJEM_SWEEP_ENABLED=
# Set true to translate and report without writing any subtitle file.
TARJEM_DRY_RUN=
